# Datenbank: Neon-Zweig "dev" (Adressen per `neon connection-string dev --pooled` bzw. ohne --pooled)
DATABASE_URL=""   # gepoolte Adresse (Host mit -pooler), für die App
DIRECT_URL=""     # direkte Adresse, für Prisma-Migrationen
DATABASE_POOL_MAX=10

# Alternative ohne Neon: `npm run db:start` (prisma dev). Dann DIRECT_URL weglassen,
# DATABASE_URL auf postgres://postgres:postgres@localhost:51218/template1?sslmode=disable,
# SHADOW_DATABASE_URL auf Port 51219 und DATABASE_POOL_MAX=1 setzen (nur eine Verbindung möglich).

# Seed: Passwort der Test-Accounts (admin@pizzadrop.test / kueche@pizzadrop.test)
SEED_PASSWORD="change-me-locally"

# Signatur der Team-Sessions, mind. 32 Zeichen (z. B. `openssl rand -base64 48`)
SESSION_SECRET=""

# Optional: eigenes Secret für Bestell-Links (mind. 32 Zeichen); ohne gilt SESSION_SECRET
# ORDER_LINK_SECRET=""

# Bild-Upload (Vercel Blob). Ohne Token speichert die lokale Entwicklung unter public/uploads.
# BLOB_READ_WRITE_TOKEN=""

# Zahlung (Stripe, Testmodus: sk_test_…). Lokal liefert `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# das Webhook-Secret (whsec_…); in Vercel kommt es aus dem Webhook-Endpunkt im Stripe-Dashboard.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Mails (Resend). Ohne Schlüssel werden Mails nur protokolliert.
RESEND_API_KEY=""
# Absender; ohne eigene Domain nur an die eigene Resend-Adresse zustellbar
# MAIL_FROM="Pizza Drop <bestellung@deine-domain.de>"

# Öffentliche Adresse für Links in Mails und Stripe (in Vercel automatisch über VERCEL_PROJECT_PRODUCTION_URL)
# APP_URL="http://localhost:3000"

# Schlüssel für /api/cron/* (mind. 32 Zeichen). Derselbe Wert als Secret CRON_SECRET in
# GitHub Actions, die die Endpunkte alle 5 min aufrufen. Ohne Schlüssel bleiben sie gesperrt.
CRON_SECRET=""
