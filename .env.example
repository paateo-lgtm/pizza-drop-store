# Datenbank: Neon-Zweig "dev" (Adressen per `neon connection-string dev --pooled` bzw. ohne --pooled)
DATABASE_URL=""   # gepoolte Adresse (Host mit -pooler), für die App
DIRECT_URL=""     # direkte Adresse, für Prisma-Migrationen
DATABASE_POOL_MAX=10

# Alternative ohne Neon: `npm run db:start` (prisma dev). Dann DIRECT_URL weglassen,
# DATABASE_URL auf postgres://postgres:postgres@localhost:51218/template1?sslmode=disable,
# SHADOW_DATABASE_URL auf Port 51219 und DATABASE_POOL_MAX=1 setzen (nur eine Verbindung möglich).

# Seed: Passwort der Test-Accounts (admin@pizzadrop.test / kueche@pizzadrop.test)
SEED_PASSWORD="change-me-locally"

# Signatur der Team-Sessions, mind. 32 Zeichen (z. B. `openssl rand -base64 48`)
SESSION_SECRET=""

# Bild-Upload (Vercel Blob). Ohne Token speichert die lokale Entwicklung unter public/uploads.
# BLOB_READ_WRITE_TOKEN=""

# Ab Phase 4
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# RESEND_API_KEY=""
