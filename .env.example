# Datenbank (lokal: `npm run db:start`, Produktion: Neon über den Vercel Marketplace)
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
# Die lokale Datenbank von `prisma dev` erlaubt nur eine Verbindung gleichzeitig:
# Pool auf 1 begrenzen und Dev-Server und E2E-Tests nicht parallel laufen lassen.
DATABASE_POOL_MAX=1
# Nur lokal für `prisma migrate dev`
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"

# Seed: Passwort der Test-Accounts (admin@pizzadrop.test / kueche@pizzadrop.test)
SEED_PASSWORD="change-me-locally"

# Signatur der Team-Sessions, mind. 32 Zeichen (z. B. `openssl rand -base64 48`)
SESSION_SECRET=""

# Bild-Upload (Vercel Blob). Ohne Token speichert die lokale Entwicklung unter public/uploads.
# BLOB_READ_WRITE_TOKEN=""

# Ab Phase 4
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# RESEND_API_KEY=""
